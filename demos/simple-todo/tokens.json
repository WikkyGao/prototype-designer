{
  "$schema": "https://design-tokens.org/schema.json",
  "color": {
    "core": {
      "paper-50": { "$value": "#FCFAF4", "$type": "color" },
      "paper-100": { "$value": "#F4F1E8", "$type": "color" },
      "ink-900": { "$value": "#1E1D1A", "$type": "color" },
      "ink-600": { "$value": "#5F5C54", "$type": "color" },
      "navy-700": { "$value": "#2F4F77", "$type": "color" },
      "navy-500": { "$value": "#3F6491", "$type": "color" },
      "brass-600": { "$value": "#8A6420", "$type": "color" },
      "brass-400": { "$value": "#C89B52", "$type": "color" },
      "green-600": { "$value": "#3F6B4E", "$type": "color" },
      "red-700": { "$value": "#963B32", "$type": "color" }
    },
    "semantic": {
      "bg": { "$value": "{color.core.paper-100}", "$type": "color" },
      "surface": { "$value": "{color.core.paper-50}", "$type": "color" },
      "text": { "$value": "{color.core.ink-900}", "$type": "color" },
      "text-muted": { "$value": "{color.core.ink-600}", "$type": "color" },
      "accent": { "$value": "{color.core.navy-700}", "$type": "color" },
      "accent-hover": { "$value": "{color.core.navy-500}", "$type": "color" },
      "mark": { "$value": "{color.core.brass-600}", "$type": "color" },
      "ok": { "$value": "{color.core.green-600}", "$type": "color" },
      "bad": { "$value": "{color.core.red-700}", "$type": "color" }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "typography": {
    "font-family": {
      "sans": { "$value": "\"PingFang SC\", \"HarmonyOS Sans SC\", system-ui, sans-serif", "$type": "fontFamily" },
      "serif": { "$value": "\"Songti SC\", \"Source Han Serif SC\", Georgia, serif", "$type": "fontFamily" },
      "mono": { "$value": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "11px", "$type": "dimension" },
      "sm": { "$value": "12.5px", "$type": "dimension" },
      "base": { "$value": "14px", "$type": "dimension" },
      "lg": { "$value": "18px", "$type": "dimension" },
      "xl": { "$value": "26px", "$type": "dimension" },
      "2xl": { "$value": "30px", "$type": "dimension" }
    }
  },
  "radius": {
    "xs": { "$value": "7px", "$type": "dimension" },
    "sm": { "$value": "10px", "$type": "dimension" },
    "md": { "$value": "14px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(20, 18, 14, 0.05)", "$type": "shadow" },
    "md": { "$value": "0 10px 30px rgba(20, 18, 14, 0.08)", "$type": "shadow" },
    "lg": { "$value": "0 24px 70px rgba(20, 18, 14, 0.16)", "$type": "shadow" }
  },
  "motion": {
    "duration": { "$value": "240ms", "$type": "duration" },
    "ease": { "$value": "cubic-bezier(.16, 1, .3, 1)", "$type": "cubicBezier" }
  }
}
