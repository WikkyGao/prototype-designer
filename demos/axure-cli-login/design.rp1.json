{
  "language": "rp/1",
  "target": 9,
  "name": "登录页 CLI 验证",
  "theme": "enterprise-light",
  "domain": "web",
  "pages": [
    {
      "id": "login",
      "name": "登录",
      "canvas": {
        "w": 1440,
        "h": 900
      },
      "root": {
        "type": "box",
        "id": "page",
        "layout": "row",
        "w": "fill",
        "h": "fill",
        "gap": 0,
        "fill": "$bg",
        "children": [
          {
            "type": "box",
            "id": "brandPanel",
            "layout": "column",
            "justify": "center",
            "w": 880,
            "h": "fill",
            "padding": 72,
            "gap": 18,
            "fill": "$ink",
            "children": [
              {
                "type": "label",
                "id": "eyebrow",
                "text": "ACME WORKSPACE",
                "w": "fill",
                "h": 20,
                "fontSize": 12,
                "fontWeight": 600,
                "color": "$surface"
              },
              {
                "type": "label",
                "id": "heroLine1",
                "text": "把团队协作",
                "w": "fill",
                "h": 54,
                "fontSize": 40,
                "fontWeight": 700,
                "color": "$surface"
              },
              {
                "type": "label",
                "id": "heroLine2",
                "text": "放在一个地方",
                "w": "fill",
                "h": 54,
                "fontSize": 40,
                "fontWeight": 700,
                "color": "$surface"
              },
              {
                "type": "label",
                "id": "brandDesc",
                "text": "内部管理后台 · 演示登录页",
                "w": "fill",
                "h": 22,
                "fontSize": 14,
                "color": "$surface"
              }
            ]
          },
          {
            "type": "box",
            "id": "formPanel",
            "layout": "column",
            "justify": "center",
            "align": "center",
            "w": 560,
            "h": "fill",
            "padding": 48,
            "gap": 0,
            "fill": "$surface",
            "children": [
              {
                "type": "box",
                "id": "form",
                "layout": "column",
                "w": 360,
                "gap": 14,
                "children": [
                  {
                    "type": "label",
                    "id": "title",
                    "text": "欢迎登录",
                    "w": "fill",
                    "h": 38,
                    "fontSize": 28,
                    "fontWeight": 700,
                    "color": "$ink"
                  },
                  {
                    "type": "label",
                    "id": "subtitle",
                    "text": "请使用企业账号登录",
                    "w": "fill",
                    "h": 22,
                    "fontSize": 13,
                    "color": "$ink-2"
                  },
                  {
                    "type": "label",
                    "id": "accountLabel",
                    "text": "账号",
                    "w": "fill",
                    "h": 20,
                    "fontSize": 13,
                    "fontWeight": 600,
                    "color": "$ink"
                  },
                  {
                    "type": "input",
                    "id": "acct",
                    "value": "",
                    "placeholder": "请输入手机号或邮箱",
                    "w": "fill",
                    "h": 40,
                    "radius": 8,
                    "stroke": "$line",
                    "textPaddingX": 12
                  },
                  {
                    "type": "label",
                    "id": "passwordLabel",
                    "text": "密码",
                    "w": "fill",
                    "h": 20,
                    "fontSize": 13,
                    "fontWeight": 600,
                    "color": "$ink"
                  },
                  {
                    "type": "input",
                    "id": "pwd",
                    "value": "",
                    "placeholder": "请输入密码",
                    "w": "fill",
                    "h": 40,
                    "radius": 8,
                    "stroke": "$line",
                    "textPaddingX": 12
                  },
                  {
                    "type": "button",
                    "id": "loginBtn",
                    "text": "登录",
                    "variant": "primary",
                    "w": "fill",
                    "h": 40,
                    "radius": 8,
                    "fontSize": 14,
                    "fontWeight": 600,
                    "on": {
                      "click": {
                        "cases": [
                          {
                            "when": {
                              "left": {
                                "widget": {
                                  "ref": "login/acct"
                                }
                              },
                              "op": "==",
                              "right": ""
                            },
                            "actions": [
                              {
                                "type": "set-text",
                                "target": {
                                  "ref": "login/status"
                                },
                                "text": "请输入账号"
                              }
                            ]
                          },
                          {
                            "when": {
                              "left": {
                                "widget": {
                                  "ref": "login/pwd"
                                }
                              },
                              "op": "==",
                              "right": ""
                            },
                            "actions": [
                              {
                                "type": "set-text",
                                "target": {
                                  "ref": "login/status"
                                },
                                "text": "请输入密码"
                              }
                            ]
                          },
                          {
                            "else": true,
                            "actions": [
                              {
                                "type": "set-text",
                                "target": {
                                  "ref": "login/status"
                                },
                                "text": "登录成功（示例）"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "type": "label",
                    "id": "status",
                    "text": "",
                    "w": "fill",
                    "h": 20,
                    "fontSize": 12,
                    "color": "$ink-2"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
